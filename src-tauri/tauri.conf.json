{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoDraw",
  "version": "0.1.0",
  "identifier": "com.storophanthus.geodraw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "GeoDraw",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "publisher": "Storophanthus",
    "category": "Education",
    "shortDescription": "Interactive geometry construction with TikZ export",
    "longDescription": "GeoDraw is a desktop tool for building interactive geometric constructions and exporting them as TikZ/tkz-euclide source for LaTeX documents.",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Storophanthus/GeoDraw/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ1QTQ2OEZCQzU1REE4NTYKUldSV3FGM0YrMmlrUlhJeS85YnNUdFAzSnR4NFc5U2VWQUpRdnFXM0F1dGdGN3RrS3FqWC9GdEIK"
    }
  }
}
